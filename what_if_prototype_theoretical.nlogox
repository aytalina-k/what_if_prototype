<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="false">
  <code><![CDATA[extensions [nw] ; loads Networks extension used to generate the preferntial-attachment network in the microblog condition
globals [experiment-seed] ; creates a global variable storing the random seed used for simulations
breed [users user] ; defines the type of agents representing members of the public or ordinary users
breed [strategists strategist] ; defines the type of agents representing committed actors
breed [posts post] ; defines the type of agents representing social media political content 
undirected-link-breed [user-links user-link] ; defines undirected links between users representing exposure channels
undirected-link-breed [infolinks infolink] ; defines undirected links between agents and posts representing posts in memory
directed-link-breed [strategist-links strategist-link]  ; defines directed links from strategists to users representing influence

users-own [fluctuation oldxcor oldycor activity civility] 
; fluctuation measures how much each user has moved during the current timestep
; oldxcor oldycor store previous position used to calculate movement
; activity is posting probability and civility characterizes user's civility level
strategists-own [oldxcor oldycor activity civility trustworthiness]
; committed actors maintain their position and do not fluctuate 
; trustworthiness characterizes the credibility of committed actors and affects content quality
posts-own [civility quality popularity post-age] ; civility is influenced by the post creator's civility
; quality is influenced by trustworthiness if posted by a strategist
; popularity is influenced by how many agents store the post in their memory and affects the visibility of the post
; post-age is the time since the post was published and affects its visibility 
user-links-own [weight] ; characterizes exposure probability based on the activity of user nodes
infolinks-own [age] ; records how long an agent has retained a particular post in memory
strategist-links-own [weight] ; characterizes exposure probability based on the activity of user nodes

;=============================================================================================================================================

to setup
  clear-all ; resets the entire simulation
  set experiment-seed new-seed ; generates a random seed and stores in experiment-seed
  random-seed experiment-seed ; starts the random sequence with experiment-seed
  if network-type = "forum" [ ; if the interface specifies the forum condition
    create-users numusers [ initialize-users ] ; creates and initializes the specified number of users
    create-strategists numstrategists [ initialize-strategists ] ; creates and initializes the specified number of committed actors
    ask users [ ; starts creating a fully connected user network
      ask other users with [who > [who] of myself] [ ; prevents creating the same undirected link twice
        create-user-link-with myself ; creates a link between every pair of users
      ]
    ]
    ask user-links [ ; assigns weights to the links depending on user activity
      set weight ([activity] of end1) * ([activity] of end2)
    ]
    ask strategists [ ; starts targeting ordinary users
      let targets n-of num-target-users users ; randomly selects a specified number of users as targets
      ask targets [
        create-strategist-link-from myself ; connects strategists to random users via directed links
      ]
    ]
    ask strategist-links [ ; assigns weights to the links depending on agents' activity
      set weight ([activity] of end1) * ([activity] of end2)
    ]
  ]
  if network-type = "microblog" [ ; if the interface specifies the microblog condition
    create-strategists numstrategists [ initialize-strategists ]  ; creates and initializes the specified number of committed actors
    let m 10 ; m is the minimun number of links each added node tries to make
    if m >= numusers [ set m max list 1 (numusers - 1) ] ; prevents m from exceeding the number of available users
    nw:set-context users user-links ; tells the Networks extension that the users and user-links constitute the relevant network
    nw:generate-preferential-attachment users user-links numusers m ; builds a preferential-attachment user network
    ; new users are more likely to connect to users who already have many connections
    ask users [ initialize-users ] ; initializes users
    ask user-links [  ; assigns weights to the links depending on user activity
      set weight ([activity] of end1) * ([activity] of end2)
    ]
    ask strategists [ ; starts targeting ordinary users
      let targets n-of num-target-users users ; randomly selects a specified number of users as targets
      ask targets [
        create-strategist-link-from myself ; connects strategists to random users via directed links
        ]
      ]
    ask strategist-links [ ; assigns weights to the links depending on agents' activity
      set weight ([activity] of end1) * ([activity] of end2)
      ]
  ]
  new-posts
  visualize 
  reset-ticks
end

to initialize-users
  set shape "person" ; displays users as people
  let sd-x max-pxcor / 2 ; sets the standard deviations of the initial x-position distributions to half the corresponding world dimension
  let sd-y max-pycor / 2 ; sets the standard deviations of the initial y-position distributions to half the corresponding world dimension
  setxy ; draws each attitude dimension from a normal distribution centred on 0 and truncates the resulting position to the world boundaries 
    (max list (- max-pxcor) (min list max-pxcor (random-normal 0 sd-x))) 
    (max list (- max-pycor) (min list max-pycor (random-normal 0 sd-y)))
  set oldxcor xcor ; stores the initial position
  set oldycor ycor ; stores the initial position
  set fluctuation 0 ; initializes the movement measure
  ifelse random-float 1 < 0.1 ; randomly assigns approximately 10% of users to the high-activity group
  [ set activity random-normal 0.8 0.1 ] ; high-activity users receive a posting probability centred around 0.8
  [ set activity random-normal 0.02 0.01 ] ; low-activity users receive a much lower posting probability
  set activity max list 0 (min list 1 activity) ; ensures activity stays between 0 and 1
  set civility min list 1 (max list -1 (random-normal 0 0.4)) ; most receive a moderate civility value, with few extreme cases
end

to initialize-strategists 
  set shape "triangle"
  set color gray - 2
  let ax (2 * random-float 1) - 1 ; ax ~ U[-1, 1] places strategists uniformly across the normalized two-dimensional attitude space
  let ay (2 * random-float 1) - 1 ; ay ~ U[-1, 1] places strategists uniformly across the normalized two-dimensional attitude space
  set oldxcor ax 
  set oldycor ay
  setxy (ax * max-pxcor) (ay * max-pycor) ; converts the normalized coordinates into actual NetLogo world coordinates
  ; thus committed actors can be moderate or extreme: being a committed actor does not itself imply ideological extremity
  set activity min list 1 (max list 0 (random-normal 0.8 0.1)); gives committed actors high but heterogeneous posting probabilities
  set civility min list 1 (max list -1 (random-normal 0 0.4)) ; most receive a moderate civility value, with few extreme cases
  set trustworthiness random-float 1 ; randomly assigns each strategist a credibility value between 0 and 1
end

;=============================================================================================================================================

to go
  age-infolinks ; memory links become one timestep older
  age-posts ; posts become one timestep older
  new-posts ; agents integrate and generate new content according to the current new-posts-mode (set in the interface)
  ask strategists [ strategic-push ] ; strategists publish/repost one post to their targeted users
  ask users [ push-post ] ; users publish/repost one post through exposure network 
  update-posts ; updates popularity and removes posts that are no longer visible
  visualize ; updates the graphical representation 
  if ticks mod update-plot-every = 0 [ update-plots ] ; updates plots at the specified in the interface interval
  tick ; advances simulation time by one timestep
  if ticks = time-steps [stop] ; stops the simulation after the specified in the interface number of timesteps
end

to new-posts
  ask users [ set oldxcor xcor set oldycor ycor ] ; stores each user's current position before any content integration can move them
  ask strategists [
    if random-float 1 < activity [ ; a strategist posts if a random draw falls below their activity value
      let creator self ; explicate who creator is to use in initialize-post submodel
      hatch-posts 1 [
        initialize-post creator ; creates and initializes the new post
    ]
  ]
]
  ; users: either individual posting or close/distant selection 
  ifelse new-posts-mode = "individual" [ ; first tries to integrate a neighbor’s post; then (independently) maybe posts
    ask users [
      let candidates turtle-set [infolink-neighbors] of user-link-neighbors ; gathers posts remembered by any linked neighbor
      set candidates candidates with [ not infolink-neighbor? myself ] ; excludes posts already in memory
      if any? candidates [ integrate-post one-of candidates ] ; if any unseen neighbor post exists, integrates one at random
      if random-float 1 < activity [  ; independently, decides to create a new post based on activity
        let creator self ; explicate who creator is to use in initialize-post submodel
        hatch-posts 1 [
          initialize-post creator ; creates and initialized the new post
        ]
      ]
    ]
  ] [
  if new-posts-mode = "close posts" or new-posts-mode = "distant posts" [
    ask users [
      let fitting-posts ifelse-value (new-posts-mode = "close posts")[ 
        ; creates a set of existing posts that fit the selected exposure condition
        posts with [
          distance myself / (max-pxcor + 0.5) < acceptance-latitude and not infolink-neighbor? myself
          ; selects posts relatively close to the user's current attitude, excludes posts the user already has in memory
        ]
      ][ posts with [
          distance myself / (max-pxcor + 0.5) >= acceptance-latitude and not infolink-neighbor? myself
          ; selects posts beyond the threshold, excludes posts the user already has in memory
        ]
      ]
      ifelse (fitting-posts = no-turtles) or (count posts < numusers) [
          ; if no suitable post exists, or there are fewer posts than users, the user creates a new post
          if random-float 1 < activity [ 
            let creator self
            hatch-posts 1 [
              initialize-post creator ; creates and initializes the new post
            ]
          ]
        ]
      [ integrate-post one-of fitting-posts ] ; otherwise attempts to integrate one randomly selected fitting post
      ]
    ]
  ]
end

to initialize-post [creator]
  set shape "dot" ; visual shape
  set color violet ; visual color
  set civility max list -1 min list 1 ([civility] of creator + (((random-float 2) - 1) * 0.1)) ; 0.1 adds a tiny variation
  ; makes the post's civility approximately equal to the creator's civility, with a small random deviation, clamps to [-1, 1]
  ifelse ([breed] of creator = users) [ ; posts created by users get random quality 
    set quality (random-float 1) ; assigns content quality uniformly in [0, 1]
  ][
    let t [trustworthiness] of creator ; posts created by committed actors get quality depending on their trustworthiness
    set quality (random-float 1) ^ (1 + 0.5 * (1 - 2 * t)) ; t=0 → 1.5, t=0.5 → 1, t=1 → 0.5
    ; assigns quality tilted by trustworthiness (low t → lower, high t → higher).
  ]
  set popularity 0 ; new posts begin with zero popularity
  set post-age 0 ; new posts begin with zero age
  let new-x ([xcor] of creator) + random-normal 0 content-noise
  let new-y ([ycor] of creator) + random-normal 0 content-noise
  ; generates content close to the creator's current attitudinal position, with normally distributed noise (set in interface)
  setxy (max list (- max-pxcor) (min list max-pxcor new-x))
        (max list (- max-pycor) (min list max-pycor new-y))
  ; places the post at that position and keeps the post within the bounded attitude space
  create-infolink-with creator [ ; the creator automatically retains their own post in memory
    set age 0
  ]
end

to push-post
  if any? infolink-neighbors and random-float 1 < activity [ ; if the user has at least one post in memory
  ; and their activity is higher than a randomly generated number in [0, 1]
    let postedinfo one-of infolink-neighbors ; they randomly select one remembered post
    if network-type = "microblog" [
      ask user-link-neighbors [ 
        if random-float 1 < [ weight ] of link-with myself [ integrate-post postedinfo ] 
        ; attempt to pass that post to all connected users depending on link weight
      ]
    ]
    if network-type = "forum" [
      let candidates user-link-neighbors in-radius 6 ; attempt to pass that post to connected users nearby
      let n random (count candidates + 1)
      if n > 0 [
        ask n-of n candidates [ 
          if random-float 1 < [ weight ] of link-with myself [ ; passes the post to each nearby user based on link weight
            integrate-post postedinfo 
          ] 
        ]
      ]
    ]
  ]
end

to strategic-push
   if any? infolink-neighbors and random-float 1 < activity [ ; if the committed actor has at least one post in memory
    ; and their activity is higher than a randomly generated number in [0, 1]
    let postedinfo one-of infolink-neighbors ; committed actors randomly select one remembered post    
    ask my-out-strategist-links [
      let exposure-probability weight
      if boost-quality-sources? and [trustworthiness] of end1 > 0.6 [
        set exposure-probability min list 1 (exposure-probability * 1.5)
      ]
      if random-float 1 < exposure-probability [
        ask end2 [
          integrate-post postedinfo
        ]
      ]
    ]
  ]
end

to integrate-post [newpost]
  if infolink-neighbor? newpost [ stop ] ; if the user already remembers the post, nothing happens
  if random-float 1 < integration-probability (distance newpost / (max-pxcor + 0.5)) acceptance-latitude acceptance-sharpness [
    ; the user probabilistically accepts the content
    if count my-infolinks >= memory [ ; if the user's memory is full
      ask max-one-of my-infolinks [age] [die] ; a post with an oldest memory link is removed from memory 
    ]
    create-infolink-with newpost [ ; the newly accepted post enters memory
      set age 0 ; the new memory link gets age 0 
    ]
    setxy mean [xcor] of infolink-neighbors mean [ycor] of infolink-neighbors
    ; the user moves to the mean position of all content currently in their memory in the attitude space
  ]
end

to update-posts
  ask posts [
    ifelse any? infolink-neighbors [ ; if at least one agent remembers the post
      set popularity count infolink-neighbors ; popularity is the number of agents currently holding the post in memory
      ifelse post-size [set size sqrt popularity] [set  size 1] ; popularity can be visualized in the interface
    ] [
      die ; if no one remembers the post it disappears
    ]
  ]
  ask posts with [post-age > 24 and popularity = 0] [ 
  ; also removes posts older than 24 timesteps that have never gained popularity
    die
  ]
end

to age-infolinks ; every memory relationship becomes one timestep older
  ask infolinks [ 
    set age age + 1 ; age refers to how long a particular agent has retained a particular post
  ]
end

to age-posts
  ask posts [
    set post-age post-age + 1 ; separately, each post accumulates its own age
  ]
end

to visualize
  ask users [ set fluctuation distancexy oldxcor oldycor / (max-pxcor + 0.5)] ; calculates how far each user moved during the timestep
  ; the switches in the interface determine whether users, posts, and the different link types are displayed
  ifelse show-users [ask users [show-turtle]] [ask users [hide-turtle]]
  ifelse show-strategists [ask strategists [show-turtle]] [ask strategists [hide-turtle]] 
  ifelse show-posts [ask posts [show-turtle]] [ask posts [hide-turtle]]
  ifelse show-infolinks [ask infolinks [show-link]] [ask infolinks [hide-link]]
  ifelse show-user-links [ask user-links [show-link]] [ask user-links [hide-link]]
  ifelse show-strategist-links [ask strategist-links [show-link]] [ask strategist-links [hide-link]]
  ifelse patch-color = "white" or count posts = 0 [
    ask patches [set pcolor white]
  ][ ; the patch-color section optionally displays the spatial concentration of posts or users
    if patch-color = "frequency posts" and count posts > 0 [ask patches [set pcolor scale-color pink (count posts-here / count posts) color-axis-max 0]]
    if patch-color = "frequency users" [ask patches [set pcolor scale-color yellow (count users-here / count users) color-axis-max 0]]
  ]
end

;=============================================================================================================================================

to-report integration-probability [dist lambda k] ; produces a probability that declines as attitudinal distance increases
  report lambda ^ k / (dist ^ k + lambda ^ k) ; so more distant content is less likely to be integrated
end

to-report mean-immigration-attitude ; calculates the average x-position of users, interpreted as their mean immigration attitude
  report mean [xcor / 16] of users
end

to-report mean-immigration-opinion ; calculates the average x-position of posts, interpreted as their mean immigration attitude
  report mean [xcor / 16] of posts
end

to-report sd-immigration-attitude ; calculates standard deviation
  report standard-deviation [xcor / 16] of users
end

to-report sd-immigration-opinion ; calculates standard deviation
  report standard-deviation [xcor / 16] of posts
end

to-report mean-climate-attitude ; calculates the average y-position of users, interpreted as their mean climate change attitude
  report mean [ycor / 16] of users
end

to-report mean-climate-opinion ; calculates the average y-position of posts, interpreted as their mean climate change attitude
  report mean [ycor / 16] of posts
end

to-report sd-climate-attitude ; calculates standard deviation
  report standard-deviation [ycor / 16] of users
end

to-report sd-climate-opinion ; calculates standard deviation
  report standard-deviation [ycor / 16] of posts
end

to-report mean-post-quality
  report mean [quality] of posts
end

to-report sd-post-quality
  report standard-deviation [quality] of posts
end

to-report mean-post-civility
  report mean [civility] of posts
end

to-report sd-post-civility
  report standard-deviation [civility] of posts
end]]></code>
  <widgets>
    <view x="590" wrappingAllowedX="false" y="37" frameRate="30.0" minPycor="-16" height="433" showTickCounter="true" patchSize="13.0" fontSize="10" wrappingAllowedY="false" width="433" tickCounterLabel="ticks" maxPycor="16" updateMode="1" maxPxcor="16" minPxcor="-16"></view>
    <slider x="12" step="1" y="37" max="1000" width="150" display="numusers" height="50" min="2" direction="Horizontal" default="1000.0" variable="numusers"></slider>
