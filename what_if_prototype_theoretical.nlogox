    <note x="1025" y="191" backgroundDark="0" fontSize="12" width="64" markdown="false" height="95" textColorDark="-1" textColorLight="-16777216" backgroundLight="0">climate change attitude (dim. 2)</note>
    <plot x="333" autoPlotX="false" yMax="20.0" autoPlotY="true" y="35" xMin="0.0" height="175" legend="false" xMax="40.0" yMin="0.0" width="230" xAxis="posts" display="users' infolinks">
      <setup></setup>
      <update>set-plot-x-range 0 10.5 * ceiling (max (fput 1 [count my-infolinks] of users) / 10)
set-plot-y-range 0 count users / 2
</update>
      <pen interval="1.0" mode="1" display="default" color="-16777216" legend="true">
        <setup></setup>
