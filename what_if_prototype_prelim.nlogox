<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="false">
  <code><![CDATA[extensions [nw]
globals [experiment-seed]
breed [users user]
breed [posts post]
breed [strategists strategist]
undirected-link-breed [user-links user-link] ; links between users
undirected-link-breed [infolinks infolink] ; links between agents and information
directed-link-breed [strategist-links strategist-link]  ; directed links from strategists to users

users-own [fluctuation civility oldxcor oldycor activity]
strategists-own [civility activity oldxcor oldycor]
posts-own [opinion civility quality popularity]
user-links-own [weight]
infolinks-own [age]

to setup
  clear-all
  set experiment-seed new-seed ; generate a random seed and store in experiment-seed
  random-seed experiment-seed ; start the random sequence with experiment-seed
  if network-type = "forum" [
    create-users numusers [ initialize-users ]
    create-strategists numstrategists [ initialize-strategists ]
    ; fully connected user network 
    ask users [
      ask other users with [who > [who] of myself] [
        create-user-link-with myself
      ]
    ]
    ; connect strategists to random users via directed links
    ask strategists [
      let targets n-of num-target-users users
      ask targets [
        create-strategist-link-from myself
      ]
    ]
  ]
  if network-type = "scale-free" [
    create-strategists numstrategists [ initialize-strategists ]
    ; build a scale-free (Barabási–Albert–type) user network (undirected)
    ; m is the number of links each added node tries to make
    let m 10
    if m >= numusers [ set m max list 1 (numusers - 1) ]
    nw:set-context users user-links
    nw:generate-preferential-attachment users user-links numusers m
    ask users [ initialize-users ]
    ; connect strategists to random users via directed links
    ask strategists [
      let targets n-of num-target-users users
      ask targets [
        create-strategist-link-from myself
      ]
    ]
  ]
  visualize
  reset-ticks
end

to initialize-users
  ask users [
    set shape "person"
    let vx random-normal 0 0.5 ; to replace with survey data (attitude toward immigration)
    let vy random-normal 0 0.5 ; to replace with survey data (attitude toward climate change)
    set oldxcor max list -1 min list 1 vx 
    set oldycor max list -1 min list 1 vy
    if dims = 1 [
      setxy (oldxcor * max-pxcor) 0
    ]
    if dims != 1 [
      setxy (oldxcor * max-pxcor) (oldycor * max-pycor)
    ]
  ]
;  setxy random-xcor  ifelse-value (dims = 1) [0] [random-ycor]
  set fluctuation 0
  set civility (random-float 2) - 1
end

to initialize-strategists
  set shape "triangle"
  set color gray - 2
  let ax (2 * random-float 1) - 1 ; ax ~ U[-1, 1]
  let ay ifelse-value (dims = 1) [0] [(2 * random-float 1) - 1] ; ay ~ U[-1, 1] or 0
  set oldxcor ax
  set oldycor ay
  setxy (ax * max-pxcor) (ay * max-pycor)
  set civility (random-float 2) - 1
end

to go
  new-posts
  ask strategists [ post-post]
  ask users [ post-post ]
  update-posts
  visualize
  if ticks mod update-plot-every = 0 [
    update-plots
  ]
  tick-advance 1
  if ticks = time-steps [stop]
end

to new-posts
  ask users [ set oldxcor xcor set oldycor ycor ]
  if new-posts-mode = "individual" [
    ask turtles with [breed != posts] [
      hatch-posts 1 [
        initialize-post
        if is-user? myself [
          ask myself [ integrate-post myself ]
      ]
    ]
  ]
]
  if new-posts-mode = "close posts" or new-posts-mode = "distant posts" [
    ask strategists [
      hatch-posts 1 [
        initialize-post
      ]
    ]
    ask users [
      let fitting-posts ifelse-value (new-posts-mode = "close posts")[
        posts with [
          distance myself / (max-pxcor + 0.5) < acceptance-latitude and not infolink-neighbor? myself
        ]
      ][ posts with [
          distance myself / (max-pxcor + 0.5) >= acceptance-latitude and not infolink-neighbor? myself
        ]
      ]
      ifelse (fitting-posts = no-turtles) or (count posts < numusers) [
          hatch-posts 1 [
            initialize-post
            ask myself [integrate-post myself] ; first myself is user, second myself is the new post
        ]
      ] 
      [ integrate-post one-of fitting-posts ]
    ]
  ]
end

to initialize-post
  set shape "dot"
  set color grey
  move-to one-of patches in-radius 1
  set popularity 0
  set quality (random-float 2) - 1
  set civility
  max (list -1
       (min (list 1
                  ([civility] of myself +
                   (((random-float 2) - 1) * 0.1))) ; 0.1 for now adds a tiny variation
    )
  ) 
end

to post-post
  if any? infolink-neighbors [
    let postedinfo one-of infolink-neighbors
    ask user-link-neighbors [ integrate-post postedinfo ]
]
end

to integrate-post [newpost]
  if random-float 1 < integration-probability (distance newpost / (max-pxcor + 0.5)) acceptance-latitude acceptance-sharpness [
    if count my-infolinks >= memory [ask one-of my-infolinks [die] ]
    create-infolink-with newpost
    setxy mean [xcor] of infolink-neighbors mean [ycor] of infolink-neighbors
  ]
end

to update-posts
  ask posts [
    ifelse any? infolink-neighbors [
      set popularity count infolink-neighbors
      ifelse post-size [set size sqrt popularity] [set  size 1]
    ] [
      die
    ]
  ]
  let avg-popularity mean [popularity] of posts
  ask posts with [popularity < avg-popularity] [
    die
  ]
end

to visualize
  ask users [ set fluctuation distancexy oldxcor oldycor / (max-pxcor + 0.5)]
  ifelse show-users [ask users [show-turtle]] [ask users [hide-turtle]]
  ifelse show-posts [ask posts [show-turtle]] [ask posts [hide-turtle]]
  ifelse show-infolinks [ask infolinks [show-link]] [ask infolinks [hide-link]]
  ifelse show-user-links [ask user-links [show-link]] [ask user-links [hide-link]]
  ifelse show-strategist-links [ask strategist-links [show-link]] [ask strategist-links [hide-link]]
  ifelse patch-color = "white" or count posts = 0 [
    ask patches [set pcolor white]
  ][
    if patch-color = "frequency posts" and count posts > 0 [ask patches [set pcolor scale-color gray (count posts-here / count posts) color-axis-max 0]]
    if patch-color = "frequency users" [ask patches [set pcolor scale-color yellow (count users-here / count users) color-axis-max 0]]
  ]
end

to baseline-settings
  set memory 20
  set acceptance-latitude 0.1
  set acceptance-sharpness 20
  set numusers 500
  set network-type "groups"
  set fraction-inter 0.2
  set dims 2
  set numcentral 1
  set time-steps 10000
  set update-plot-every 201
end

to baseline-visualization
  set show-users true
  set show-posts false
  set post-size false
  set show-infolinks true
  set patch-color "white"
  set color-axis-max 0.05
end

to-report integration-probability [dist lambda k]
  report lambda ^ k / (dist ^ k + lambda ^ k)
end]]></code>
